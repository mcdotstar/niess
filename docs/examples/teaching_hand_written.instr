/* A small McStas instrument, written by hand.
 *
 * The "Translate an existing .instr" guide turns this file into niess.teaching.
 * It is deliberately plain: no niess metadata, no generated sections.
 *
 * Its knobs follow the names and units ESS publishes: chopper delays in nanoseconds
 * and degrees, a jaw edge in millimetres. Each is converted where a component takes it.
 * The chopper's total delay is formed as an ESS chopper controller forms TotDly:
 * MechDly / (360 |speed|) + BeamPosDly + ChopDly.
 */
DEFINE INSTRUMENT teaching_hand_written(
  chopper_rotation_speed = 14.0,
  chopper_experiment_delay = 0.0,
  chopper_mechanical_delay = 275.0,
  pulse_delay = 0.0,
  jaw_left = 15.0,
  jaw_right = -15.0
)

TRACE

COMPONENT moderator = ESS_butterfly(
  sector = "W", beamline = 4, yheight = 0.03, cold_frac = 0.5,
  Lmin = 0.75, Lmax = 5.0
) AT (0, 0, 0) ABSOLUTE

COMPONENT unit_1 = Guide_gravity(
  l = 2.0, w1 = 0.04, h1 = 0.06, w2 = 0.04, h2 = 0.06, m = 2.0
) AT (0, 0, 1.5) RELATIVE moderator

COMPONENT unit_2 = Guide_gravity(
  l = 3.0, w1 = 0.04, h1 = 0.06, w2 = 0.04, h2 = 0.06, m = 3.0
) AT (0, 0, 2.01) RELATIVE unit_1

COMPONENT chopper = DiskChopper(
  radius = 0.35, theta_0 = 170.0, nu = chopper_rotation_speed, delay = 1e-9 * (pulse_delay + chopper_experiment_delay)
    + (chopper_rotation_speed ? chopper_mechanical_delay / (360.0 * fabs(chopper_rotation_speed)) : 0.0),
  nslit = 1, yheight = 0.06
) AT (0, 0, 3.25) RELATIVE unit_2

COMPONENT jaw = Slit(
  xmin = 0.001 * jaw_right, xmax = 0.001 * jaw_left, yheight = 0.05
) AT (0, 0, 3.75) RELATIVE unit_2

COMPONENT monitor = TOF_monitor(
  xwidth = 0.05, yheight = 0.05, nt = 512, tmin = 0, tmax = 100000,
  restore_neutron = 1
) AT (0, 0, 3.95) RELATIVE unit_2

COMPONENT sample_origin = Arm() AT (0, 0, 4.95) RELATIVE unit_2

END
